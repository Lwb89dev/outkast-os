/* Outkast GTK3 — colori nominati ({{scheme_name}}): gli stessi nomi di libadwaita, usati da adw-gtk3 */
@define-color accent_bg_color {{accent}};
@define-color accent_fg_color {{on}};
@define-color accent_color {{accent}};
@define-color destructive_bg_color {{red}};
@define-color destructive_fg_color {{deep}};
@define-color destructive_color {{red}};
@define-color success_bg_color {{green}};
@define-color success_fg_color {{deep}};
@define-color success_color {{green}};
@define-color warning_bg_color {{amber}};
@define-color warning_fg_color {{deep}};
@define-color warning_color {{amber}};
@define-color error_bg_color {{red}};
@define-color error_fg_color {{deep}};
@define-color error_color {{red}};

@define-color window_bg_color {{bg}};
@define-color window_fg_color {{fg}};
@define-color view_bg_color {{view}};
@define-color view_fg_color {{fg}};
@define-color headerbar_bg_color {{bg}};
@define-color headerbar_fg_color {{fg}};
@define-color headerbar_border_color {{outline}};
@define-color headerbar_backdrop_color {{bg}};
@define-color headerbar_shade_color {{outline}};
@define-color headerbar_darker_shade_color {{outline}};
@define-color sidebar_bg_color {{sidebar}};
@define-color sidebar_fg_color {{fg}};
@define-color sidebar_backdrop_color {{sidebar}};
@define-color sidebar_shade_color {{outline}};
@define-color sidebar_border_color {{outline}};
@define-color card_bg_color {{surface}};
@define-color card_fg_color {{fg}};
@define-color card_shade_color {{line}};
@define-color dialog_bg_color {{dialog}};
@define-color dialog_fg_color {{fg}};
@define-color popover_bg_color {{dialog}};
@define-color popover_fg_color {{fg}};
@define-color popover_shade_color {{line}};
@define-color thumbnail_bg_color {{surface}};
@define-color thumbnail_fg_color {{fg}};
@define-color shade_color {{line}};
@define-color scrollbar_outline_color {{bg}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{on}};

/* Nostri: filetto, superfici, testo attenuato, segnale tenue */
@define-color o_line {{outline}};
@define-color o_line_soft {{line}};
@define-color o_raised {{raised}};
@define-color o_sunken {{sunken}};
@define-color o_dim {{fg3}};
@define-color o_faint {{fg4}};
@define-color o_soft {{soft}};
@define-color o_red {{red}};
@define-color o_red_fg {{deep}};
