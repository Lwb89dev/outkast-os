# Outkast — Alacritty. Generato da templates/extras/alacritty.toml.in.
# Uso:  import = ["~/.local/share/themes/Outkast/extras/terminals/alacritty.toml"]  in alacritty.toml

[colors.primary]
background = "{{bg}}"
foreground = "{{fg}}"
dim_foreground = "{{fg2}}"

[colors.cursor]
text = "{{on}}"
cursor = "{{accent}}"

[colors.selection]
text = "{{on}}"
background = "{{accent}}"

[colors.normal]
black = "{{ansi0}}"
red = "{{ansi1}}"
green = "{{ansi2}}"
yellow = "{{ansi3}}"
blue = "{{ansi4}}"
magenta = "{{ansi5}}"
cyan = "{{ansi6}}"
white = "{{ansi7}}"

[colors.bright]
black = "{{ansi8}}"
red = "{{ansi9}}"
green = "{{ansi10}}"
yellow = "{{ansi11}}"
blue = "{{ansi12}}"
magenta = "{{ansi13}}"
cyan = "{{ansi14}}"
white = "{{ansi15}}"
